{
  "name": "PlanB Flutter Codespace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspace/exam_prep_app",
  "postCreateCommand": "flutter pub get",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-vscode.cpptools"
      ]
    }
  },
  "forwardPorts": [
    8080,
    5000
  ]
}
